{
  "permissions": {
    "deny": [
      "Read(./data/**)",
      "Read(./cache/**)",
      "Read(./evaluation/gt/**)",
      "Read(./evaluation/results/**)",
      "Read(./evaluation/reports/**)",
      "Read(./submissions/*.csv)",
      "Read(**/*.mp4)",
      "Bash(cat data/*)",
      "Bash(head data/*)",
      "Bash(tail data/*)",
      "Bash(less data/*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/board-session-start.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/board-prompt.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
